// FabriGroup Rent Manager - Multi-tenant Automotive SaaS
// Prisma schema: tenants/RBAC, fleet & compliance, contracts, workshop,
// damages/claims, blacklist, fines, documents, cash register, notifications.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  super_admin // FabriGroup platform owner - all tenants
  admin // tenant owner/administrator
  responsabile // location/fleet manager
  operator // desk operator
  officina // workshop staff
  contabilita // accounting/invoicing
  visualizzatore // read-only
  client

  @@map("user_role")
}

enum BookingService {
  rent
  parking

  @@map("booking_service")
}

enum ParkingSlotType {
  coperto
  scoperto

  @@map("parking_slot_type")
}

enum ParkingCategory {
  moto
  auto
  furgone

  @@map("parking_category")
}

enum VehicleStatus {
  available
  rented
  maintenance
  guasto
  fuori_flotta
  non_disponibile

  @@map("vehicle_status")
}

enum VehicleOwnershipType {
  aziendale
  leasing
  sub_noleggio
  comodato_uso
  altro

  @@map("vehicle_ownership_type")
}

enum VehicleExitReason {
  venduta
  rottamata
  esportata
  incidente
  altro

  @@map("vehicle_exit_reason")
}

enum PricingScope {
  rent
  parking

  @@map("pricing_scope")
}

enum PricingRuleType {
  date_range // e.g. alta stagione, ponti, festivita' (explicit start/end date)
  weekday // Mon-Fri
  weekend // Sat-Sun
  holiday // single recurring/one-off holiday date

  @@map("pricing_rule_type")
}

enum InsuranceZone {
  sud_italia
  centro_nord_italia

  @@map("insurance_zone")
}

enum InsuranceTier {
  base
  medium
  full
  kasko_senza_cauzione

  @@map("insurance_tier")
}

enum DocumentType {
  id_card_front
  id_card_back
  license_front
  license_back

  @@map("document_type")
}

enum DocumentAuditStatus {
  pending
  approved
  reupload_requested

  @@map("document_audit_status")
}

enum CheckInMethod {
  digital_signature
  otp_sms

  @@map("check_in_method")
}

enum ContractSignatureStatus {
  none
  link_sent
  otp_pending
  signed

  @@map("contract_signature_status")
}

enum ExtensionChannel {
  whatsapp
  web

  @@map("extension_channel")
}

enum ExtensionStatus {
  pending
  approved
  rejected

  @@map("extension_status")
}

enum DamageTicketStatus {
  open
  deposit_withheld
  resolved

  @@map("damage_ticket_status")
}

enum PaymentType {
  rental_charge // automatic capture, main rent/parking total
  deposit_authorization // capture_method manual, pre-auth cauzione
  kasko_charge // direct immediate charge, franchigia 0, total incl. insurance
  extra_charge // extras, penalty, damage captured later by desk
  refund

  @@map("payment_type")
}

enum PaymentMethod {
  contanti
  pos
  stripe
  sumup
  bonifico
  altro

  @@map("payment_method")
}

enum PaymentStatus {
  pending
  authorized
  captured
  failed
  refunded
  canceled

  @@map("payment_status")
}

enum InvoiceStatus {
  draft
  queued
  sent
  accepted
  rejected
  error

  @@map("invoice_status")
}

enum WorkshopCategory {
  meccanica
  carrozzeria
  gommista
  elettrauto

  @@map("workshop_category")
}

enum DamageRecordType {
  graffio
  ammaccatura
  paraurti
  vetro
  pneumatico
  interni
  carrozzeria
  meccanica
  altro

  @@map("damage_record_type")
}

enum DamageRecordStatus {
  aperto
  in_valutazione
  addebitato
  chiuso

  @@map("damage_record_status")
}

enum ClaimStatus {
  aperto
  in_istruttoria
  liquidazione
  chiuso
  respinto

  @@map("claim_status")
}

enum BlacklistReason {
  danno
  mancato_pagamento
  frode
  comportamento_scorretto
  incidente
  documento_falso
  altro

  @@map("blacklist_reason")
}

enum BlacklistStatus {
  attiva
  in_verifica
  archiviata

  @@map("blacklist_status")
}

enum FineStatus {
  da_notificare
  notificata
  in_ricorso
  pagata
  archiviata

  @@map("fine_status")
}

enum ExpenseCategory {
  carburante
  operaio
  ricambi
  buoni_pasto
  fornitori
  altro

  @@map("expense_category")
}

enum NotificationType {
  contratto_non_firmato
  rientro_imminente
  pagamento_scaduto
  assicurazione_scadenza
  revisione_scadenza
  bollo_scadenza
  manutenzione_scadenza
  danno
  multa
  fattura_non_inviata
  pec_non_inviata

  @@map("notification_type")
}

enum NotificationSeverity {
  info
  warning
  critical

  @@map("notification_severity")
}

// ---------------------------------------------------------------------------
// Tenants & Locations (multi-tenant / multi-sede SaaS)
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  vatNumber String?  @map("vat_number")
  pec       String?
  sdiCode   String?  @map("sdi_code")
  address   String?
  logoUrl   String?  @map("logo_url")

  nextContractNumber Int @default(1) @map("next_contract_number")

  // Default franchigie (company-editable) used to prefill the legal
  // rental contract template - never hardcoded in the PDF generator.
  franchigiaRcaAmount      Decimal @default(0) @db.Decimal(10, 2) @map("franchigia_rca_amount")
  franchigiaRcaPercent     Decimal @default(0) @db.Decimal(5, 2) @map("franchigia_rca_percent")
  franchigiaKaskoAmount    Decimal @default(0) @db.Decimal(10, 2) @map("franchigia_kasko_amount")
  franchigiaKaskoPercent   Decimal @default(0) @db.Decimal(5, 2) @map("franchigia_kasko_percent")
  franchigiaFurtoAmount    Decimal @default(0) @db.Decimal(10, 2) @map("franchigia_furto_amount")
  franchigiaFurtoPercent   Decimal @default(0) @db.Decimal(5, 2) @map("franchigia_furto_percent")
  franchigiaIncendioAmount Decimal @default(0) @db.Decimal(10, 2) @map("franchigia_incendio_amount")
  franchigiaIncendioPercent Decimal @default(0) @db.Decimal(5, 2) @map("franchigia_incendio_percent")
  franchigiaDanniAmount    Decimal @default(0) @db.Decimal(10, 2) @map("franchigia_danni_amount")
  franchigiaDanniPercent   Decimal @default(0) @db.Decimal(5, 2) @map("franchigia_danni_percent")

  maintenanceIntervalKm Int @default(10000) @map("maintenance_interval_km")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  locations             Location[]
  users                 User[]
  vehicles              Vehicle[]
  vehicleInsurancePolicies VehicleInsurancePolicy[]
  pricingRules          PricingRule[]
  parkingBaseRates      ParkingBaseRate[]
  parkingCapacities     ParkingCapacity[]
  insuranceOptions      InsuranceOption[]
  extraServices         ExtraService[]
  bookings              Booking[]
  documentAudits        DocumentAudit[]
  damageReports         DamageReport[]
  damageTickets         DamageTicket[]
  extensionRequests     ExtensionRequest[]
  payments              Payment[]
  invoices              Invoice[]
  auditLogs             AuditLog[]
  workshopCatalogItems  WorkshopCatalogItem[]
  workshopInterventions WorkshopIntervention[]
  damageRecords         DamageRecord[]
  claims                Claim[]
  blacklistEntries      BlacklistEntry[]
  fines                 Fine[]
  issuingAuthorities    IssuingAuthority[]
  documents             Document[]
  expenses              Expense[]
  notifications         Notification[]
  aiInteractionLogs     AiInteractionLog[]

  @@map("tenants")
}

model Location {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  name      String
  address   String?
  isPrimary Boolean @default(false) @map("is_primary")

  // Google Geocoding (section 3) - popolati alla scrittura dell'indirizzo
  // tramite src/lib/maps.ts; null finche' GOOGLE_MAPS_API_KEY non e' configurata.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  placeId   String?  @map("place_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users    User[]
  vehicles Vehicle[]
  bookings Booking[]

  @@index([tenantId])
  @@map("locations")
}

// ---------------------------------------------------------------------------
// Users & Auth
// ---------------------------------------------------------------------------

model User {
  id                  String   @id @default(uuid())
  tenantId            String?  @map("tenant_id") // null only for platform super_admin
  locationId          String?  @map("location_id")
  fullName            String   @map("full_name")
  email               String   @unique
  passwordHash        String?  @map("password_hash")
  phone               String
  role                UserRole @default(client)

  idCardNumber        String?  @map("id_card_number")
  driverLicenseNumber String?  @map("driver_license_number")

  idCardFrontUrl      String?  @map("id_card_front_url")
  idCardBackUrl        String? @map("id_card_back_url")
  licenseFrontUrl     String?  @map("license_front_url")
  licenseBackUrl      String?  @map("license_back_url")

  // Fatturazione elettronica
  companyName         String?  @map("company_name") // Ragione Sociale / Nome
  vatNumber           String?  @map("vat_number") // P.IVA / Codice Fiscale
  sdiCode             String?  @map("sdi_code") // Codice Univoco SDI
  pec                 String?

  // Auth hardening: brute-force lockout (section: sicurezza)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")

  // 2FA (TOTP)
  twoFactorEnabled      Boolean  @default(false) @map("two_factor_enabled")
  twoFactorSecret        String? @map("two_factor_secret") // encrypted at rest, see src/lib/crypto-secret.ts
  twoFactorBackupCodes  String[] @map("two_factor_backup_codes") // bcrypt hashes, single-use

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant              Tenant?  @relation(fields: [tenantId], references: [id])
  location            Location? @relation(fields: [locationId], references: [id])

  bookings            Booking[]               @relation("BookingCustomer")
  operatedBookings    Booking[]               @relation("BookingOperator")
  documentAudits      DocumentAudit[]
  reviewedAudits      DocumentAudit[]         @relation("DocumentAuditReviewer")
  auditLogs           AuditLog[]
  priceOverrides      Booking[]               @relation("BookingPriceOverrideBy")
  workshopInterventions WorkshopIntervention[]
  damageRecords       DamageRecord[]
  claims              Claim[]
  blacklistEntries    BlacklistEntry[]
  fines               Fine[]
  documents           Document[]
  expenses            Expense[]
  aiInteractionLogs   AiInteractionLog[]

  @@index([tenantId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Fleet
// ---------------------------------------------------------------------------

model Vehicle {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  locationId     String?       @map("location_id")

  name           String // es. "Fiat Panda 1.0 Hybrid"
  brand          String? // Marca (snapshot testuale, mostrato in tutta l'app)
  model          String? // Modello (snapshot testuale)
  brandId        String?       @map("brand_id") // FK opzionale al database globale marche/modelli
  vehicleModelId String?       @map("vehicle_model_id")
  category       String // es. "City Car" - matching group used for "o simile" assignment
  isOrSimilar    Boolean       @default(true) @map("is_or_similar")
  dailyRate      Decimal       @db.Decimal(10, 2) @map("daily_rate")
  status         VehicleStatus @default(available)
  seats          Int?
  transmission   String?
  fuelType       String?       @map("fuel_type")
  imageUrl       String?       @map("image_url")
  plate          String?
  chassisNumber  String?       @map("chassis_number") // telaio
  year           Int?
  odometerKm     Int?          @map("odometer_km")
  maintenanceNote String?      @map("maintenance_note")

  bolloExpiryDate     DateTime? @map("bollo_expiry_date")
  revisioneExpiryDate DateTime? @map("revisione_expiry_date")
  lastMaintenanceKm   Int?      @map("last_maintenance_km")

  ownershipType       VehicleOwnershipType @default(aziendale) @map("ownership_type")
  purchaseVendor      String?              @map("purchase_vendor")
  purchaseDate        DateTime?            @map("purchase_date")
  purchasePrice       Decimal?             @db.Decimal(10, 2) @map("purchase_price")
  purchasePaymentMethod String?            @map("purchase_payment_method")
  purchaseInvoiceUrl  String?              @map("purchase_invoice_url")

  exitDate            DateTime?            @map("exit_date")
  exitReason          VehicleExitReason?   @map("exit_reason")

  gpsDeviceId         String?              @map("gps_device_id")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  location       Location?     @relation(fields: [locationId], references: [id])
  brandRef       VehicleBrand? @relation(fields: [brandId], references: [id])
  modelRef       VehicleModel? @relation(fields: [vehicleModelId], references: [id])

  bookings       Booking[]
  insurancePolicies VehicleInsurancePolicy[]
  workshopInterventions WorkshopIntervention[]
  damageRecords  DamageRecord[]
  claims         Claim[]
  fines          Fine[]

  @@unique([tenantId, plate])
  @@index([tenantId])
  @@index([brandId])
  @@index([vehicleModelId])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// Global vehicle make/model catalog (section 7) - tenant-independent lookup
// data used to populate fleet forms with a searchable combobox instead of
// free text. Vehicle.brand/model stay as editable text snapshots so a
// tenant can still register a vehicle that isn't in the catalog yet.
// ---------------------------------------------------------------------------

model VehicleBrand {
  id        String  @id @default(uuid())
  name      String  @unique
  slug      String  @unique
  logoUrl   String? @map("logo_url")

  createdAt DateTime @default(now()) @map("created_at")

  models    VehicleModel[]
  vehicles  Vehicle[]

  @@map("vehicle_brands")
}

model VehicleModel {
  id        String   @id @default(uuid())
  brandId   String   @map("brand_id")
  name      String
  category  String? // suggerimento categoria "o simile" (City Car, SUV, ...)

  createdAt DateTime @default(now()) @map("created_at")

  brand     VehicleBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]

  @@unique([brandId, name])
  @@index([brandId])
  @@map("vehicle_models")
}

// ---------------------------------------------------------------------------
// Vehicle insurance policies (section 9)
// ---------------------------------------------------------------------------

model VehicleInsurancePolicy {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  vehicleId         String   @map("vehicle_id")

  company           String
  policyNumber      String   @map("policy_number")

  rcaAmount         Decimal? @db.Decimal(10, 2) @map("rca_amount")
  rcaPercent        Decimal? @db.Decimal(5, 2) @map("rca_percent")
  kaskoAmount       Decimal? @db.Decimal(10, 2) @map("kasko_amount")
  kaskoPercent      Decimal? @db.Decimal(5, 2) @map("kasko_percent")
  theftFireAmount   Decimal? @db.Decimal(10, 2) @map("theft_fire_amount")
  theftFirePercent  Decimal? @db.Decimal(5, 2) @map("theft_fire_percent")
  damageAmount      Decimal? @db.Decimal(10, 2) @map("damage_amount")
  damagePercent     Decimal? @db.Decimal(5, 2) @map("damage_percent")

  periodStart       DateTime @map("period_start")
  periodEnd         DateTime @map("period_end")
  premium           Decimal? @db.Decimal(10, 2)
  broker            String?
  roadsideAssistance Boolean @default(false) @map("roadside_assistance")
  gpsTracking       Boolean  @default(false) @map("gps_tracking")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vehicleId])
  @@map("vehicle_insurance_policies")
}

// ---------------------------------------------------------------------------
// Dynamic pricing (super admin governance)
// ---------------------------------------------------------------------------

model PricingRule {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  name          String // es. "Alta stagione agosto", "Ponte 25 aprile"
  scope         PricingScope
  type          PricingRuleType
  startDate     DateTime?       @map("start_date") // for date_range / holiday
  endDate       DateTime?       @map("end_date") // for date_range
  category      String? // optional: restrict rule to a vehicle/parking category
  multiplier    Decimal         @default(1) @db.Decimal(5, 2) // e.g. 1.30 = +30%
  fixedRate     Decimal?        @db.Decimal(10, 2) @map("fixed_rate") // overrides base rate entirely if set
  priority      Int             @default(0) // higher wins when multiple rules match
  active        Boolean         @default(true)

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("pricing_rules")
}

model ParkingBaseRate {
  id           String          @id @default(uuid())
  tenantId     String          @map("tenant_id")
  category     ParkingCategory
  dailyRate    Decimal         @db.Decimal(10, 2) @map("daily_rate") // scoperto base rate
  copertoUplift Decimal        @default(0.40) @db.Decimal(5, 2) @map("coperto_uplift") // +40%

  tenant       Tenant          @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, category])
  @@map("parking_base_rates")
}

model ParkingCapacity {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  slotType  ParkingSlotType
  maxSlots  Int             @map("max_slots")
  updatedAt DateTime        @updatedAt @map("updated_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, slotType])
  @@map("parking_capacity")
}

// ---------------------------------------------------------------------------
// Insurance (geo-localized franchigie for rent bookings)
// ---------------------------------------------------------------------------

model InsuranceOption {
  id                 String        @id @default(uuid())
  tenantId           String        @map("tenant_id")
  zone               InsuranceZone
  tier               InsuranceTier
  label              String // e.g. "Franchigia Base", "KASKO Senza Cauzione"
  residualDeductible Decimal       @db.Decimal(10, 2) @map("residual_deductible") // never 0 for sud_italia tiers
  dailyCost          Decimal       @db.Decimal(10, 2) @map("daily_cost")
  requiresCreditCard Boolean       @default(false) @map("requires_credit_card") // KASKO only
  active             Boolean       @default(true)

  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  bookings           Booking[]

  @@unique([tenantId, zone, tier])
  @@map("insurance_options")
}

// ---------------------------------------------------------------------------
// Extra services (upselling)
// ---------------------------------------------------------------------------

model ExtraService {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  code        String // car_wash, child_seat, additional_driver, shuttle
  label       String
  price       Decimal  @db.Decimal(10, 2)
  perDay      Boolean  @default(false) @map("per_day")
  active      Boolean  @default(true)

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  bookingExtras BookingExtraService[]

  @@unique([tenantId, code])
  @@map("extra_services")
}

model BookingExtraService {
  id             String       @id @default(uuid())
  bookingId      String       @map("booking_id")
  extraServiceId String       @map("extra_service_id")
  quantity       Int          @default(1)
  unitPrice      Decimal      @db.Decimal(10, 2) @map("unit_price") // snapshot at booking time

  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  extraService   ExtraService @relation(fields: [extraServiceId], references: [id])

  @@map("booking_extra_services")
}

// ---------------------------------------------------------------------------
// Bookings / Contracts
// ---------------------------------------------------------------------------

model Booking {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  locationId      String?        @map("location_id")
  contractNumber  Int?           @map("contract_number") // sequential per tenant, rent contracts only
  userId          String         @map("user_id")
  serviceType     BookingService @map("service_type")

  // Rent
  vehicleId       String?        @map("vehicle_id")
  authorizedDrivers Json?        @map("authorized_drivers") // [{fullName, licenseNumber}]

  // Parking (Parking Go)
  parkingType     ParkingSlotType?  @map("parking_type")
  parkingCategory ParkingCategory?  @map("parking_category")
  keysLeft        Boolean        @default(false) @map("keys_left")

  startDate       DateTime       @map("start_date")
  endDate         DateTime       @map("end_date")
  location        String         @default("Via Privata Detta Sacra 33")

  // Insurance (rent only)
  insuranceOptionId String?      @map("insurance_option_id")

  basePrice       Decimal        @db.Decimal(10, 2) @map("base_price")
  insurancePrice  Decimal        @default(0) @db.Decimal(10, 2) @map("insurance_price")
  extrasPrice     Decimal        @default(0) @db.Decimal(10, 2) @map("extras_price")
  totalPrice      Decimal        @db.Decimal(10, 2) @map("total_price")
  depositAmount   Decimal        @default(0) @db.Decimal(10, 2) @map("deposit_amount")
  hasDeposit      Boolean        @default(true) @map("has_deposit")
  downPaymentAmount Decimal      @default(0) @db.Decimal(10, 2) @map("down_payment_amount") // acconto

  priceOverride       Decimal?   @db.Decimal(10, 2) @map("price_override")
  priceOverrideReason  String?   @map("price_override_reason")
  priceOverrideById    String?   @map("price_override_by_id")

  paymentStatus   String         @default("pending") @map("payment_status")
  paymentMethod   PaymentMethod? @map("payment_method")

  // Signature / digital contract (section 4-5)
  signatureStatus    ContractSignatureStatus @default(none) @map("signature_status")
  signatureLinkToken String?                 @unique @map("signature_link_token")
  signatureSentAt    DateTime?               @map("signature_sent_at")
  signatureCompletedAt DateTime?             @map("signature_completed_at")

  // Check-in / check-out (desk operator workflow)
  checkInAt       DateTime?      @map("check_in_at")
  checkInKm       Int?           @map("check_in_km")
  checkInFuel     String?        @map("check_in_fuel")
  checkInMethod   CheckInMethod? @map("check_in_method")
  signatureUrl    String?        @map("signature_url")
  otpVerifiedAt   DateTime?      @map("otp_verified_at")
  operatorId      String?        @map("operator_id")

  actualReturnAt  DateTime?      @map("actual_return_at")
  checkOutKm      Int?           @map("check_out_km")
  checkOutFuel    String?        @map("check_out_fuel")

  penaltyAppliedAt     DateTime? @map("penalty_applied_at")
  penaltyAmount        Decimal?  @db.Decimal(10, 2) @map("penalty_amount")
  penaltyReason        String?   @map("penalty_reason")

  status          String         @default("confirmed") // confirmed, checked_in, completed, canceled

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  siteLocation    Location?       @relation(fields: [locationId], references: [id])
  user            User            @relation("BookingCustomer", fields: [userId], references: [id])
  vehicle         Vehicle?        @relation(fields: [vehicleId], references: [id])
  insuranceOption InsuranceOption? @relation(fields: [insuranceOptionId], references: [id])
  operator        User?           @relation("BookingOperator", fields: [operatorId], references: [id])
  priceOverrideBy User?           @relation("BookingPriceOverrideBy", fields: [priceOverrideById], references: [id])

  extras          BookingExtraService[]
  damageReports   DamageReport[]
  damageTickets   DamageTicket[]
  extensionRequests ExtensionRequest[] @relation("ExtensionOriginBooking")
  bumpedByExtensions ExtensionRequest[] @relation("ExtensionBumpedBooking")
  payments        Payment[]
  documentAudits  DocumentAudit[]
  invoices        Invoice[]
  damageRecords   DamageRecord[]
  claims          Claim[]
  fines           Fine[]

  @@unique([tenantId, contractNumber])
  @@index([tenantId])
  @@index([userId])
  @@index([vehicleId])
  @@index([startDate, endDate])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Document audit (4-slot uploader verification by desk operator)
// ---------------------------------------------------------------------------

model DocumentAudit {
  id           String              @id @default(uuid())
  tenantId     String              @map("tenant_id")
  userId       String              @map("user_id")
  bookingId    String?             @map("booking_id")
  documentType DocumentType        @map("document_type")
  fileUrl      String              @map("file_url")
  status       DocumentAuditStatus @default(pending)
  reviewedById String?             @map("reviewed_by_id")
  reviewNote   String?             @map("review_note")
  reviewedAt   DateTime?           @map("reviewed_at")
  createdAt    DateTime            @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
  booking      Booking? @relation(fields: [bookingId], references: [id])
  reviewedBy   User?    @relation("DocumentAuditReviewer", fields: [reviewedById], references: [id])

  @@index([tenantId])
  @@map("document_audits")
}

// ---------------------------------------------------------------------------
// Damage logging (check-in/out flow) - unchanged behaviour, now tenant-scoped
// ---------------------------------------------------------------------------

model DamageReport {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  bookingId   String   @map("booking_id")
  photoUrls   String[] @map("photo_urls") // pre-existing damage photos at check-in
  notes       String?
  reportPdfUrl String? @map("report_pdf_url") // report + contract PDF sent to customer
  emailSentAt DateTime? @map("email_sent_at")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("damage_reports")
}

model DamageTicket {
  id                    String             @id @default(uuid())
  tenantId              String             @map("tenant_id")
  bookingId             String             @map("booking_id")
  description           String
  depositWithheldAmount Decimal            @default(0) @db.Decimal(10, 2) @map("deposit_withheld_amount")
  reportPdfUrl          String?            @map("report_pdf_url") // descriptive report, no photos
  status                DamageTicketStatus @default(open)
  createdAt             DateTime           @default(now()) @map("created_at")
  resolvedAt            DateTime?          @map("resolved_at")

  tenant                Tenant             @relation(fields: [tenantId], references: [id])
  booking               Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("damage_tickets")
}

// ---------------------------------------------------------------------------
// Standalone Danni module (section 12) - searchable, independent of check-in
// ---------------------------------------------------------------------------

model DamageRecord {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  vehicleId       String?            @map("vehicle_id")
  bookingId       String?            @map("booking_id")
  customerId      String?            @map("customer_id")

  type            DamageRecordType
  position        String?
  photoUrls       String[]           @map("photo_urls")
  videoUrls       String[]           @map("video_urls")
  documentUrls    String[]           @map("document_urls")
  costEstimated   Decimal?           @db.Decimal(10, 2) @map("cost_estimated")
  costFinal       Decimal?           @db.Decimal(10, 2) @map("cost_final")
  franchigiaAmount Decimal?          @db.Decimal(10, 2) @map("franchigia_amount")
  status          DamageRecordStatus @default(aperto)
  notes           String?

  operatorId      String?            @map("operator_id")
  date            DateTime           @default(now())
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  vehicle         Vehicle?           @relation(fields: [vehicleId], references: [id])
  booking         Booking?           @relation(fields: [bookingId], references: [id])
  operator        User?              @relation(fields: [operatorId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
  @@map("damage_records")
}

// ---------------------------------------------------------------------------
// Sinistri / Claims (section 13)
// ---------------------------------------------------------------------------

model Claim {
  id                String      @id @default(uuid())
  tenantId          String      @map("tenant_id")
  vehicleId         String?     @map("vehicle_id")
  bookingId         String?     @map("booking_id")
  customerId        String?     @map("customer_id")

  date              DateTime
  location          String?
  dynamics          String?
  photoUrls         String[]    @map("photo_urls")
  documentUrls      String[]    @map("document_urls")
  insuranceCompany  String?     @map("insurance_company")
  franchigiaAmount  Decimal?    @db.Decimal(10, 2) @map("franchigia_amount")
  status            ClaimStatus @default(aperto)
  costs             Decimal?    @db.Decimal(10, 2)
  responsibleParty  String?     @map("responsible_party")
  notes             String?

  operatorId        String?     @map("operator_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  vehicle           Vehicle?    @relation(fields: [vehicleId], references: [id])
  booking           Booking?    @relation(fields: [bookingId], references: [id])
  operator          User?       @relation(fields: [operatorId], references: [id])

  @@index([tenantId])
  @@map("claims")
}

// ---------------------------------------------------------------------------
// Blacklist (section 14)
// ---------------------------------------------------------------------------

model BlacklistEntry {
  id             String          @id @default(uuid())
  tenantId       String          @map("tenant_id")
  customerId     String?         @map("customer_id")
  fullNameSnapshot String        @map("full_name_snapshot")
  fiscalCode     String?         @map("fiscal_code")
  contractId     String?         @map("contract_id")
  plate          String?

  reason         BlacklistReason
  details        String
  amountDue      Decimal?        @db.Decimal(10, 2) @map("amount_due")
  documentUrls   String[]        @map("document_urls")
  photoUrls      String[]        @map("photo_urls")
  status         BlacklistStatus @default(attiva)

  operatorId     String?         @map("operator_id")
  date           DateTime        @default(now())
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  operator       User?           @relation(fields: [operatorId], references: [id])

  @@index([tenantId])
  @@map("blacklist_entries")
}

// ---------------------------------------------------------------------------
// Enti verbalizzanti / PEC directory (section 16)
// ---------------------------------------------------------------------------

model IssuingAuthority {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  pec          String?
  source       String? // where the PEC was verified/found
  verifiedAt   DateTime? @map("verified_at")
  notes        String?

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  fines        Fine[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("issuing_authorities")
}

// ---------------------------------------------------------------------------
// Multe (section 15/17)
// ---------------------------------------------------------------------------

model Fine {
  id                 String     @id @default(uuid())
  tenantId           String     @map("tenant_id")
  plate              String
  vehicleId          String?    @map("vehicle_id")
  contractId         String?    @map("contract_id")
  customerId         String?    @map("customer_id")

  violationDate      DateTime   @map("violation_date")
  violationTime      String?    @map("violation_time")
  verbaleNumber      String     @map("verbale_number")
  issuingAuthorityId String?    @map("issuing_authority_id")
  amount             Decimal    @db.Decimal(10, 2)
  dueDate            DateTime?  @map("due_date")
  documentUrl        String?    @map("document_url")
  status             FineStatus @default(da_notificare)
  appealPdfUrl        String?   @map("appeal_pdf_url")

  operatorId         String?    @map("operator_id")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  vehicle            Vehicle?         @relation(fields: [vehicleId], references: [id])
  contract           Booking?         @relation(fields: [contractId], references: [id])
  issuingAuthority   IssuingAuthority? @relation(fields: [issuingAuthorityId], references: [id])
  operator           User?            @relation(fields: [operatorId], references: [id])

  @@index([tenantId])
  @@index([plate])
  @@map("fines")
}

// ---------------------------------------------------------------------------
// Officina / Workshop (section 11)
// ---------------------------------------------------------------------------

model WorkshopCatalogItem {
  id        String           @id @default(uuid())
  tenantId  String           @map("tenant_id")
  category  WorkshopCategory
  label     String
  active    Boolean          @default(true)

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  interventions WorkshopIntervention[]

  @@unique([tenantId, category, label])
  @@index([tenantId])
  @@map("workshop_catalog_items")
}

model WorkshopIntervention {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  vehicleId       String           @map("vehicle_id")
  catalogItemId   String?          @map("catalog_item_id")
  category        WorkshopCategory
  label           String // snapshot, in case a custom/freeform intervention was used

  price           Decimal?         @db.Decimal(10, 2)
  parts           String?          @map("parts") // ricambi
  supplier        String?          // fornitore
  km              Int?
  notes           String?
  documentUrl     String?          @map("document_url")
  invoiceUrl      String?          @map("invoice_url")

  operatorId      String?          @map("operator_id")
  date            DateTime         @default(now())
  createdAt       DateTime         @default(now()) @map("created_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  vehicle         Vehicle              @relation(fields: [vehicleId], references: [id])
  catalogItem     WorkshopCatalogItem? @relation(fields: [catalogItemId], references: [id])
  operator        User?                @relation(fields: [operatorId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
  @@map("workshop_interventions")
}

// ---------------------------------------------------------------------------
// Generic document repository (section 30)
// ---------------------------------------------------------------------------

model Document {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  entityType   String   @map("entity_type") // customer, contract, vehicle, insurance, fine, claim, workshop, invoice
  entityId     String   @map("entity_id")
  fileUrl      String   @map("file_url")
  fileName     String   @map("file_name")
  fileType     String   @map("file_type")
  ocrData      Json?    @map("ocr_data")
  notes        String?

  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Smart extension engine
// ---------------------------------------------------------------------------

model ExtensionRequest {
  id                 String            @id @default(uuid())
  tenantId           String            @map("tenant_id")
  bookingId          String            @map("booking_id") // booking being extended
  channel            ExtensionChannel
  requestedEndDate   DateTime          @map("requested_end_date")
  status             ExtensionStatus   @default(pending)

  // if the specific vehicle was already booked by a second client, that
  // second booking gets auto-reassigned to another "o simile" vehicle so
  // the first booking's extension can be approved.
  bumpedBookingId    String?           @map("bumped_booking_id")
  reassignedVehicleId String?          @map("reassigned_vehicle_id")

  decidedById        String?           @map("decided_by_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  decidedAt          DateTime?         @map("decided_at")

  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  booking            Booking  @relation("ExtensionOriginBooking", fields: [bookingId], references: [id], onDelete: Cascade)
  bumpedBooking       Booking? @relation("ExtensionBumpedBooking", fields: [bumpedBookingId], references: [id])

  @@index([tenantId])
  @@map("extension_requests")
}

// ---------------------------------------------------------------------------
// Payments (Stripe / SumUp / cash / bank transfer)
// ---------------------------------------------------------------------------

model Payment {
  id                    String        @id @default(uuid())
  tenantId              String        @map("tenant_id")
  bookingId             String        @map("booking_id")
  type                  PaymentType
  method                PaymentMethod @default(stripe)
  status                PaymentStatus @default(pending)
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("eur")
  // Not unique: a non-KASKO rental combines the rental charge and the
  // deposit hold into a single Stripe PaymentIntent (see booking-service.ts),
  // so two Payment rows can point at the same stripePaymentIntentId.
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  sumupCheckoutId       String?       @map("sumup_checkout_id")
  sumupTransactionId    String?       @map("sumup_transaction_id")
  captureMethod         String        @default("automatic") @map("capture_method") // "manual" for deposit auth
  failureReason         String?       @map("failure_reason")
  idempotencyKey        String?       @unique @map("idempotency_key")
  createdAt             DateTime      @default(now()) @map("created_at")
  capturedAt            DateTime?     @map("captured_at")
  canceledAt            DateTime?     @map("canceled_at")

  tenant                Tenant        @relation(fields: [tenantId], references: [id])
  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([stripePaymentIntentId])
  @@index([sumupCheckoutId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Fatturazione elettronica (section 18)
// ---------------------------------------------------------------------------

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  bookingId     String        @map("booking_id")
  number        String
  taxableAmount Decimal       @db.Decimal(10, 2) @map("taxable_amount")
  vatAmount     Decimal       @db.Decimal(10, 2) @map("vat_amount")
  totalAmount   Decimal       @db.Decimal(10, 2) @map("total_amount")
  xmlUrl        String?       @map("xml_url")
  sdiReceiptUrl String?       @map("sdi_receipt_url")
  status        InvoiceStatus @default(draft)
  errorMessage  String?       @map("error_message")
  sentAt        DateTime?     @map("sent_at")

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  booking       Booking       @relation(fields: [bookingId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Cassa - Expenses (section 21)
// ---------------------------------------------------------------------------

model Expense {
  id          String          @id @default(uuid())
  tenantId    String          @map("tenant_id")
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  description String?
  date        DateTime        @default(now())

  operatorId  String?         @map("operator_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  operator    User?           @relation(fields: [operatorId], references: [id])

  @@index([tenantId])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Notification / alert center (section 27)
// ---------------------------------------------------------------------------

model Notification {
  id         String                @id @default(uuid())
  tenantId   String                @map("tenant_id")
  type       NotificationType
  severity   NotificationSeverity  @default(info)
  entityType String?               @map("entity_type")
  entityId   String?               @map("entity_id")
  message    String
  readAt     DateTime?             @map("read_at")
  dismissedAt DateTime?            @map("dismissed_at")

  createdAt  DateTime              @default(now()) @map("created_at")

  tenant     Tenant                @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([type])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Audit log (governance)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?  @map("tenant_id")
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  ipAddress  String?  @map("ip_address")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([tenantId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// AI Assistant interaction log (section AI Assistant) - every tool call the
// assistant makes is recorded here for audit, cost control and rate
// limiting, independently of AuditLog (which tracks human-driven writes).
// ---------------------------------------------------------------------------

model AiInteractionLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  actorId       String   @map("actor_id")
  prompt        String // user message, truncated to a safe length before storage
  toolsUsed     Json?    @map("tools_used") // [{name, input, resultSummary}]
  responsePreview String? @map("response_preview")
  model         String
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  actor         User     @relation(fields: [actorId], references: [id])

  @@index([tenantId])
  @@index([actorId])
  @@map("ai_interaction_log")
}
