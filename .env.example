# Copy this file to .env and fill in real values before deploying.
# `npm run db:migrate` / `npm run dev` need DATABASE_URL and AUTH_SECRET at minimum;
# everything else has a safe dev-mode fallback (see the comments below).

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL="postgresql://fabrirent:fabrirent_dev@localhost:5432/fabrirent?schema=public"

# --- Auth (NextAuth v5) -------------------------------------------------------
# Generate with: openssl rand -base64 32
# Also used to derive the encryption key for 2FA secrets at rest
# (src/lib/crypto-secret.ts) - rotating it invalidates existing 2FA
# enrollments (users re-enroll) and all active sessions.
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Rate limiting (src/lib/rate-limit.ts) ------------------------------------
# Left unset: rate limiting runs in-memory, correct for a single Node
# process (the current docker-compose.yml topology). REQUIRED as soon as
# the app runs on more than one instance behind a load balancer, otherwise
# each instance enforces its own separate counter.
REDIS_URL=""

# --- Stripe --------------------------------------------------------------------
# Without real keys the app still builds and runs; payment confirmation will
# fail client-side (as expected) until test/live keys are provided.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- OTP SMS provider (src/lib/otp-provider.ts) -------------------------------
# Left unset in dev: OTP codes are logged to the server console instead of sent.
SMS_PROVIDER_API_KEY=""

# --- Email provider (src/lib/email-provider.ts) -------------------------------
# Left unset in dev: emails (damage reports, contracts) are logged to the
# server console instead of sent.
EMAIL_PROVIDER_API_KEY=""

# --- AI Vision / OCR document scanning (src/lib/ocr-provider.ts) -------------
# Left unset in dev: /desk document scanner falls back to manual data entry
# with a clear "OCR non configurato" notice instead of faking extracted data.
AI_VISION_API_KEY=""

# --- Aruba fatturazione elettronica / SDI (src/lib/aruba.ts) -----------------
# Left unset in dev: invoices are generated as XML and kept in "draft" status
# with an honest "SDI non configurato" error instead of a fake "sent" state.
ARUBA_SDI_API_KEY=""
ARUBA_SDI_ENDPOINT=""

# --- Vehicle plate lookup (src/lib/plate-lookup.ts) --------------------------
# Left unset in dev: /admin/flotta's "Cerca targa" button returns an honest
# "non configurato" message and the operator fills in the vehicle manually.
# No specific vendor is wired in - PLATE_LOOKUP_ENDPOINT must point at an
# adapter that implements the request/response contract documented in
# INTEGRATIONS.md (Italian plate->vehicle-data lookups are a paid commercial
# service; there is no free public API for this).
PLATE_LOOKUP_API_KEY=""
PLATE_LOOKUP_ENDPOINT=""

# --- RESERVED FOR FUTURE INTEGRATIONS -----------------------------------------
# The variables below are NOT read by any code yet. They document the
# integrations named in the product spec that this session deliberately
# scaffolded a UI/data-model for but stubbed out (see README "Cosa non e'
# stato implementato"). Wire them up when the corresponding provider work
# is picked up; until then leaving them unset/empty has no effect.
SUMUP_API_KEY=""
GOOGLE_MAPS_API_KEY=""
GPS_PROVIDER_API_KEY=""
